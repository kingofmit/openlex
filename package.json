{
  "name": "openlex",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source jurisdiction mapping engine — given a legal topic and location, returns applicable statutes, regulations, and governing bodies across all 50 U.S. states.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/openlex.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "tsx": "^4.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  }
}
