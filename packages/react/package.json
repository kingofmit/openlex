{
  "name": "@openlex/react",
  "version": "0.1.0",
  "description": "React hooks and components for the OpenLex jurisdiction mapping engine.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/openlex.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kingofmit/openlex",
