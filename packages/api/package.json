{
  "name": "@allem-law/api",
  "version": "0.1.0",
  "description": "REST API server for OpenLex jurisdiction mapping engine.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/openlex.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/kingofmit/openlex",
  "bugs": "https://github.com/kingofmit/openlex/issues",
  "keywords": ["legal", "law", "statutes", "jurisdiction", "united-states", "openlex", "api", "rest", "hono", "server"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@allem-law/core": "workspace:*",
    "@allem-law/statutes": "workspace:*",
    "@allem-law/regulations": "workspace:*",
    "@allem-law/courts": "workspace:*",
    "@allem-law/search": "workspace:*",
    "@allem-law/export": "workspace:*",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0"
  }
}
